# DevPulse Backend Configuration Variables
# Rename this file to .env and set your values

# Cryptographic key for payload HMAC verification
DEVPULSE_SECRET_KEY=your-production-secret-key-change-this

# Application environment status (production or development)
APP_ENV=production

# Path to search script (optional)
# DEVPULSE_SKILL_SCRIPT=path/to/script.py
